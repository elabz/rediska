# Rediska Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# IMAGE TAG (used by docker-compose to pull pre-built images from GHCR)
# =============================================================================
# `latest` follows main's HEAD. Set to a commit SHA for a specific build,
# or to roll back to a prior known-good version.
TAG=latest

# =============================================================================
# DATABASE
# =============================================================================
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=rediska
MYSQL_USER=rediska
MYSQL_PASSWORD=your_password_here
MYSQL_URL=mysql+pymysql://rediska:your_password_here@rediska-mysql:3306/rediska

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://rediska-redis:6379/0
CELERY_BROKER_URL=redis://rediska-redis:6379/1
CELERY_RESULT_BACKEND=redis://rediska-redis:6379/2

# =============================================================================
# ELASTICSEARCH
# =============================================================================
ELASTIC_URL=http://rediska-elasticsearch:9200

# =============================================================================
# STORAGE (host paths mounted to containers)
# =============================================================================
ATTACHMENTS_PATH=/var/lib/rediska/attachments
BACKUPS_PATH=/var/lib/rediska/backups

# =============================================================================
# LLM ENDPOINTS (llama.cpp)
# =============================================================================
INFERENCE_URL=http://localhost:8080/v1
INFERENCE_MODEL=your_model_name
INFERENCE_API_KEY=
# Global cap on simultaneous LLM requests across all worker processes. Keep at 1 for a
# single llama.cpp instance without --parallel; raise to match its slot count otherwise.
INFERENCE_MAX_CONCURRENT=1
# Retries on 429/5xx (gateway cooldown, busy backend); first delay doubles each retry.
INFERENCE_MAX_RETRIES=4
INFERENCE_RETRY_BASE_DELAY=10

EMBEDDINGS_URL=http://localhost:8080/v1
EMBEDDINGS_MODEL=your_embeddings_model
EMBEDDINGS_API_KEY=

# =============================================================================
# WEB APPLICATION
# =============================================================================
BASE_URL=https://rediska.local
NEXTAUTH_SECRET=generate_a_random_secret_here

# =============================================================================
# PROVIDER: REDDIT
# =============================================================================
PROVIDER_REDDIT_ENABLED=true
PROVIDER_REDDIT_CLIENT_ID=
PROVIDER_REDDIT_CLIENT_SECRET=
PROVIDER_REDDIT_REDIRECT_URI=https://rediska.local/api/providers/reddit/callback
PROVIDER_REDDIT_USER_AGENT=Rediska/1.0

# =============================================================================
# LEAD ANALYSIS GATES (deterministic suitability gates)
# =============================================================================
# The user's own constraints consumed by the code gates (gender, location,
# D/s compatibility, partner max age, authenticity).
USER_AGE=45
USER_DS_ORIENTATION=dominant

# Per-dimension agent input budgets. Raise ANALYSIS_CONTEXT_MAX_CHARS only if
# the local model's context window comfortably exceeds it (~4 chars/token).
ANALYSIS_CONTEXT_MAX_CHARS=24000
ANALYSIS_MAX_RECENT_POSTS=10
ANALYSIS_POST_ITEM_CHARS=800

# Human evaluation (analysis-evaluation): hard cap on labelled cases replayed
# per prompt replay from /settings/agents (most recent first). Each case is
# one local inference call through the shared gate.
EVALUATION_REPLAY_MAX_CASES=50

# Lead triage: scout-sourced leads still `new` after this many days are set to
# `expired` by the daily maintenance.expire_stale_leads task. 0 disables (the
# default): leads are kept and the Leads page filters by date instead.
# Manual leads never expire; expired leads can be revived from the Leads page.
LEAD_EXPIRY_DAYS=0

# Offline geocoding for the location gate (near/far/unclear)
HOME_LATITUDE=40.0
HOME_LONGITUDE=-75.2
LOCATION_NEAR_THRESHOLD_MILES=200

# Operator note on scout watch `min_confidence` thresholds:
# The confidence score is computed deterministically and banded by
# recommendation: not_recommended 0.0-0.3, needs_review 0.3-0.6,
# suitable 0.6-1.0. Only gate-verdict `suitable` posts are eligible for
# auto-promotion, and a suitable lead starts at 0.6 — so a watch with
# min_confidence=0.5 promotes every suitable post, while 0.7 demands
# genuine margin (strong compatibility + high dimension confidences).

# =============================================================================
# RATE LIMITING
# =============================================================================
PROVIDER_RATE_QPM_DEFAULT=60
PROVIDER_RATE_CONCURRENCY_DEFAULT=2
PROVIDER_RATE_BURST_FACTOR=1.5
